# Copy to .env for local Docker use. Generate the JWT value; do not commit real secrets.
POSTGRES_DB=room_rental
POSTGRES_USER=room_rental
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_URL=jdbc:postgresql://db:5432/room_rental
DB_USERNAME=room_rental
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_BASE64=replace-with-base64-encoded-32-byte-secret
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost:4200
SERVER_PORT=8080
